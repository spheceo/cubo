{
  "name": "cubo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@cubo/web' --filter '@cubo/site' --filter '@cubo/desktop' dev",
    "dev:web": "bun --filter '@cubo/web' dev",
    "dev:site": "bun --filter '@cubo/site' dev",
    "dev:core": "cargo run -p cubo-cli -- serve --no-open",
    "dev:desktop": "bun --filter '@cubo/web' --filter '@cubo/desktop' dev",
    "build": "bun run --recursive build",
    "typecheck": "bun run --recursive typecheck"
  }
}
