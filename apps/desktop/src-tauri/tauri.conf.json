{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cubo",
  "version": "0.1.0",
  "identifier": "com.cubo.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @cubo/web dev",
    "beforeBuildCommand": "pnpm --filter @cubo/web build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "cubo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
